# AgentRouter Phase 1 runtime credentials
# Copy to .env and fill with real test-only values.

# Daytona sandbox lifecycle
DAYTONA_API_KEY=

# AgentRouter API auth for local clients / SDK
AGENTROUTER_API_KEY=ar_dev_local_change_me

# OpenAI Codex runtime
# Server-side only. The credential boundary must not copy this into general sandbox env.
CODEX_API_KEY=
CODEX_HOME=.codex-runtime

# Phase 1B only: Anthropic Claude Code runtime
# Server-side only. The credential boundary must not copy this into general sandbox env.
ANTHROPIC_API_KEY=

# Cloudflare R2 artifact storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agentrouter-runtime-artifacts-dev
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ARTIFACT_PREFIX=dev/runs/

# Optional: only needed if artifacts should be downloadable from a browser
R2_PUBLIC_BASE_URL=

# Test harness guardrails
AGENTROUTER_TEST_RESOURCE_PREFIX=ar-phase1-test
AGENTROUTER_HEARTBEAT_INTERVAL_SECONDS=30
AGENTROUTER_STALE_HEARTBEAT_GRACE_SECONDS=180
DAYTONA_SANDBOX_TTL_SECONDS=900

# Real E2E fixture repository used by API/worker tests
AGENTROUTER_E2E_REPO_URL=
AGENTROUTER_E2E_REPO_BASE_REF=main

# Test database
DATABASE_URL=
